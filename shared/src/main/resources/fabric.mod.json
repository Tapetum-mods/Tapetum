{
  "schemaVersion": 1,
  "id": "tapetumshaders",
  "version": "${version}",
  "name": "Tapetum Shaders",
  "description": "Independent Tapetum shader engine for OptiFine-format shaderpacks. Requires Sodium.",
  "authors": [
    "Raik"
  ],
  "contact": {
    "homepage": "https://github.com/raik-fr/Tapetum-Shaders",
    "sources": "https://github.com/raik-fr/Tapetum-Shaders",
    "issues": "https://github.com/raik-fr/Tapetum-Shaders/issues"
  },
  "license": "LGPL-3.0-only",
  "environment": "client",
  "entrypoints": {
    "main": [
      "dev.tapetum.shaders.TapetumShaders"
    ],
    "client": [
      "dev.tapetum.shaders.TapetumShadersClient"
    ]
  },
  "mixins": [
    "tapetumshaders.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.3",
    "minecraft": "~${minecraftVersion}",
    "java": ">=25",
    "sodium": ">=0.9.2 <0.10"
  }
}
